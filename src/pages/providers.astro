---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Meet our Providers | Southaven Internal Medicine"
  description="Meet Dr. Magdi Wassef and Dr. Mary Missak, board-certified internal medicine physicians with over 30 years of experience serving Southaven, MS."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://res.cloudinary.com/dil14r8je/image/upload/v1768286994/auto-site-builder/railway-test-1/image_10.jpg')"
      ></div>
      <div class="absolute inset-0 hero-overlay"></div>
      
      <div class="relative z-10 container-custom">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-6">
            Meet Our Providers
          </h1>
          <p class="text-xl mb-8">
            Board-certified physicians with over 30 years of experience
          </p>
        </div>
      </div>
    </section>

    <!-- Providers Section -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <!-- Dr. Magdi Wassef -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
          <div class="order-2 lg:order-1">
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Magdi Wassef</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Magdi Wassef has been practicing internal medicine for over thirty years.
              </p>
              <p class="mb-4">
                He graduated from Alexandria Medical School in Egypt in 1985.
              </p>
              <p class="mb-4">
                He then traveled to Wales, United Kingdom, for his internal medicine residency in 1989.
              </p>
              <p class="mb-4">
                From there, his journey brought him to the United States where he completed his residency 
                at Methodist University Hospital.
              </p>
              <p class="mb-4">
                After completing his residency, Dr. Wassef practiced in Tallahatchie General Hospital in 
                Charleston, MS from 1994 to 1996 and then moved back to Memphis where he started 
                Southaven Internal Medicine in 1996.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Professional Affiliations</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Board Certified in Internal Medicine</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Memphis Medical Society</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Tennessee Medical Association</span>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="order-1 lg:order-2">
            <div class="bg-light-blue p-8 rounded-lg text-center">
              <img 
                src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286993/auto-site-builder/railway-test-1/image_9.jpg" 
                alt="Dr. Magdi Wassef" 
                class="w-48 h-48 rounded-full object-cover mx-auto mb-6 shadow-lg"
              />
              <h3 class="text-2xl font-bold text-navy mb-2">Dr. Magdi Wassef, MD</h3>
              <p class="text-teal font-semibold mb-4">Board Certified Internal Medicine</p>
              <p class="text-gray-700">Founder & Lead Physician<br>30+ Years Experience</p>
            </div>
          </div>
        </div>

        <!-- Dr. Mary Missak -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="bg-light-blue p-8 rounded-lg text-center">
              <img 
                src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286991/auto-site-builder/railway-test-1/image_0.jpg" 
                alt="Dr. Mary Missak" 
                class="w-48 h-48 rounded-full object-cover mx-auto mb-6 shadow-lg"
              />
              <h3 class="text-2xl font-bold text-navy mb-2">Dr. Mary Missak, MD</h3>
              <p class="text-teal font-semibold mb-4">Board Certified Internal Medicine</p>
              <p class="text-gray-700">Associate Physician<br>Expert in Preventative Care</p>
            </div>
          </div>
          
          <div>
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Mary Missak</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Mary Missak is a board-certified internal medicine physician dedicated to providing 
                comprehensive healthcare with a focus on preventative medicine.
              </p>
              <p class="mb-4">
                She brings extensive experience in managing chronic conditions including diabetes, 
                hypertension, and cardiovascular disease.
              </p>
              <p class="mb-4">
                Dr. Missak is committed to building strong patient relationships and believes in 
                treating each patient as family.
              </p>
              <p class="mb-4">
                Her approach emphasizes patient education and collaborative care to help patients 
                achieve optimal health outcomes.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Areas of Expertise</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Preventative Medicine & Health Screenings</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Chronic Disease Management</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Women's Health & Wellness</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Geriatric Medicine</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="section-padding bg-navy">
      <div class="container-custom">
        <div class="text-center text-white">
          <h2 class="text-3xl lg:text-4xl font-bold mb-6">
            Ready to Experience Exceptional Care?
          </h2>
          <p class="text-xl mb-8 max-w-3xl mx-auto">
            Schedule an appointment with one of our board-certified physicians today. 
            We're here to provide the personalized, comprehensive care you deserve.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
              Call (662) 349-1999
            </a>
            <a href="/#pre-register" class="bg-white text-navy px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 hover:bg-gray-100">
              Pre-Register Online
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>