---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Meet our Providers | Southaven Internal Medicine"
  description="Meet Dr. Magdi Wassef and Dr. Mary Missak, board-certified internal medicine physicians with over 30 years of experience serving Southaven, MS."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://res.cloudinary.com/dil14r8je/image/upload/v1768286994/auto-site-builder/railway-test-1/image_10.jpg')"
      ></div>
      <div class="absolute inset-0 hero-overlay"></div>
      
      <div class="relative z-10 container-custom">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-6">
            Meet Our Providers
          </h1>
          <p class="text-xl mb-8">
            Board-certified physicians with over 30 years of experience
          </p>
        </div>
      </div>
    </section>

    <!-- Providers Section -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <!-- Dr. Magdi Wassef -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
          <div class="order-2 lg:order-1">
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Magdi Wassef</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Magdi Wassef has been practicing internal medicine for over thirty years.
              </p>
              <p class="mb-4">
                He graduated from Alexandria Medical School in Egypt in 1985.
              </p>
              <p class="mb-4">
                He then traveled to Wales, United Kingdom, for his internal medicine residency in 1989.
              </p>
              <p class="mb-4">
                From there, his journey brought him to the United States where he completed his residency 
                at Methodist University Hospital.
              </p>
              <p class="mb-4">
                After completing his residency, Dr. Wassef practiced in Tallahatchie General Hospital in 
                Charleston, MS from 1994 to 1996 and then moved back to Memphis where he started 
                Southaven Internal Medicine in 1996.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Professional Affiliations</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>American College of Physicians</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>American Medical Association</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Board Certified in Internal Medicine</span>
                </li>
              </ul>
            </div>
            
            <div class="text-gray-700">
              <p class="mb-4">
                He is married to Amira and they have two college aged children, Megan and David.
              </p>
              <p>
                When he is not working, Dr. Wassef enjoys spending time with his family and friends and serving in his church.
              </p>
            </div>
          </div>
          
          <div class="order-1 lg:order-2 text-center">
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286994/auto-site-builder/railway-test-1/image_11.jpg" 
              alt="Dr. Magdi Wassef" 
              class="mx-auto rounded-lg shadow-lg max-w-sm"
            />
            <div class="mt-6 bg-navy p-6 rounded-lg text-white">
              <h3 class="text-xl font-semibold mb-2">Dr. Magdi Wassef</h3>
              <p class="text-teal font-medium">Founder & Physician</p>
              <p class="text-gray-300 text-sm mt-2">Internal Medicine</p>
            </div>
          </div>
        </div>

        <!-- Dr. Mary Missak -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="text-center">
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286994/auto-site-builder/railway-test-1/image_12.jpg" 
              alt="Dr. Mary Missak" 
              class="mx-auto rounded-lg shadow-lg max-w-sm"
            />
            <div class="mt-6 bg-navy p-6 rounded-lg text-white">
              <h3 class="text-xl font-semibold mb-2">Dr. Mary Missak</h3>
              <p class="text-teal font-medium">Physician</p>
              <p class="text-gray-300 text-sm mt-2">Internal Medicine</p>
            </div>
          </div>
          
          <div>
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Mary Missak</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Mary Missak has been practicing internal medicine for over 30 years.
              </p>
              <p class="mb-4">
                She graduated from University Of Alexandria Medical School in 1978.
              </p>
              <p class="mb-4">
                After spending time in England, Dr. Missak moved to Memphis for her internal medicine 
                residency at Methodist University Hospital.
              </p>
              <p class="mb-4">
                In 2000, she joined her brother (Dr. Wassef) at Southaven Internal Medicine.
              </p>
              <p class="mb-4">
                In 2019, Dr. Missak received her MBA from Christian Brothers University.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Leadership Roles</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Chief of Medicine at Baptist Desoto Hospital</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Medical Director for Campus Hospice Southaven</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>MBA from Christian Brothers University (2019)</span>
                </li>
              </ul>
            </div>
            
            <div class="text-gray-700">
              <p class="mb-4">
                She has two children who are both in the medical field.
              </p>
              <p>
                When she is not working, Dr. Missak loves to paint and spend time with friends and family.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Practice Philosophy -->
    <section class="section-padding bg-light-blue">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-navy mb-8">Our Practice Philosophy</h2>
          <p class="text-lg text-gray-700 mb-8 leading-relaxed">
            Together, Dr. Wassef and Dr. Missak bring over 60 years of combined medical experience to 
            Southaven Internal Medicine. Their commitment to patient-centered care, combined with their 
            extensive training and ongoing education, ensures that every patient receives the highest 
            quality medical care in a warm, family-like environment.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
            <div class="bg-white p-6 rounded-lg shadow-md">
              <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-navy mb-3">Compassionate Care</h3>
              <p class="text-gray-700">Treating every patient like family with kindness and understanding.</p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md">
              <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-navy mb-3">Expert Knowledge</h3>
              <p class="text-gray-700">Board-certified physicians with decades of experience and ongoing education.</p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md">
              <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-navy mb-3">Community Focus</h3>
              <p class="text-gray-700">Dedicated to serving the Southaven community for nearly three decades.</p>
            </div>
          </div>
          
          <div class="mt-12">
            <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
              Schedule with Our Providers
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>