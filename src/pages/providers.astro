---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Meet our Providers | Southaven Internal Medicine"
  description="Meet Dr. Magdi Wassef and Dr. Mary Missak, board-certified internal medicine physicians with over 30 years of experience serving Southaven, MS."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://res.cloudinary.com/dil14r8je/image/upload/v1768286994/auto-site-builder/railway-test-1/image_10.jpg')"
      ></div>
      <div class="absolute inset-0 hero-overlay"></div>
      
      <div class="relative z-10 container-custom">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-6">
            Meet Our Providers
          </h1>
          <p class="text-xl mb-8">
            Board-certified physicians with over 30 years of experience
          </p>
        </div>
      </div>
    </section>

    <!-- Providers Section -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <!-- Dr. Magdi Wassef -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
          <div class="order-2 lg:order-1">
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Magdi Wassef</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Magdi Wassef has been practicing internal medicine for over thirty years.
              </p>
              <p class="mb-4">
                He graduated from Alexandria Medical School in Egypt in 1985.
              </p>
              <p class="mb-4">
                He then traveled to Wales, United Kingdom, for his internal medicine residency in 1989.
              </p>
              <p class="mb-4">
                From there, his journey brought him to the United States where he completed his residency 
                at Methodist University Hospital.
              </p>
              <p class="mb-4">
                After completing his residency, Dr. Wassef practiced in Tallahatchie General Hospital in 
                Charleston, MS from 1994 to 1996 and then moved back to Memphis where he started 
                Southaven Internal Medicine in 1996.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Professional Affiliations</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Board Certified in Internal Medicine</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Memphis Medical Society</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>American College of Physicians</span>
                </li>
              </ul>
            </div>
            
            <div class="bg-teal bg-opacity-10 p-6 rounded-lg">
              <h3 class="text-xl font-semibold text-navy mb-2">Specializing In:</h3>
              <p class="text-gray-700">
                Preventative medicine, chronic disease management, and comprehensive internal medicine care.
              </p>
            </div>
          </div>
          
          <div class="order-1 lg:order-2">
            <div class="relative">
              <div class="w-full h-96 bg-gradient-to-br from-teal to-navy rounded-lg flex items-center justify-center">
                <div class="text-center text-white">
                  <svg class="w-24 h-24 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <h3 class="text-2xl font-bold mb-2">Dr. Magdi Wassef</h3>
                  <p class="text-lg">Board Certified Internal Medicine</p>
                  <p class="text-sm mt-2">30+ Years Experience</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Dr. Mary Missak -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-1">
            <div class="relative">
              <div class="w-full h-96 bg-gradient-to-br from-navy to-teal rounded-lg flex items-center justify-center">
                <div class="text-center text-white">
                  <svg class="w-24 h-24 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <h3 class="text-2xl font-bold mb-2">Dr. Mary Missak</h3>
                  <p class="text-lg">Board Certified Internal Medicine</p>
                  <p class="text-sm mt-2">Expert in Family-Centered Care</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="order-2">
            <h2 class="text-3xl font-bold text-navy mb-6">Dr. Mary Missak</h2>
            <div class="prose prose-lg text-gray-700">
              <p class="mb-4">
                Dr. Mary Missak is a board-certified internal medicine physician dedicated to providing 
                comprehensive, compassionate care to her patients.
              </p>
              <p class="mb-4">
                With extensive training and experience in internal medicine, Dr. Missak focuses on 
                preventative care and chronic disease management.
              </p>
              <p class="mb-4">
                She is committed to building lasting relationships with her patients and ensuring they 
                receive personalized care tailored to their individual health needs.
              </p>
              <p class="mb-4">
                Dr. Missak believes in treating each patient like family and works closely with 
                Dr. Wassef to provide the highest quality medical care in a warm, welcoming environment.
              </p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Areas of Expertise</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Comprehensive Health Screenings</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Women's Health</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Diabetes and Hypertension Management</span>
                </li>
              </ul>
            </div>
            
            <div class="bg-teal bg-opacity-10 p-6 rounded-lg">
              <h3 class="text-xl font-semibold text-navy mb-2">Patient-Centered Approach:</h3>
              <p class="text-gray-700">
                Dedicated to making every patient feel comfortable and well-cared for in a family-like environment.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="section-padding bg-light-blue">
      <div class="container-custom">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-navy mb-6">
            Ready to Experience Compassionate Care?
          </h2>
          <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
            Schedule your appointment with our experienced physicians today. 
            We're committed to helping you achieve your best health.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="tel:662-349-1999" class="btn-primary">
              Call (662) 349-1999
            </a>
            <a href="/#pre-register" class="btn-secondary">
              Pre-Register Online
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>