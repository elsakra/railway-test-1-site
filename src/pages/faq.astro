---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="FAQ | Southaven Internal Medicine"
  description="Frequently asked questions about Southaven Internal Medicine including insurance, lab services, telehealth, and payment options."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="bg-navy py-16">
      <div class="container-custom">
        <div class="text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
          <p class="text-xl text-gray-300 max-w-2xl mx-auto">
            Find answers to common questions about our services, insurance, and policies
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Content -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- FAQ List -->
          <div class="lg:col-span-2">
            <div class="space-y-8">
              <!-- Insurance FAQ -->
              <div class="bg-light-blue p-8 rounded-lg">
                <h2 class="text-2xl font-bold text-navy mb-4">What insurances do you all accept?</h2>
                <p class="text-gray-700 mb-4">
                  We take all major insurances except for the following:
                </p>
                <ul class="space-y-2 text-gray-700">
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>CIGA-Connect Network</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>TN Care</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>United Healthcare 3 Rivers</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>United Healthcare Common Plan</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>United Healthcare Ambetter</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>United Healthcare Compass</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-red-500 font-bold mt-1">×</span>
                    <span>United Healthcare Dual Complete</span>
                  </li>
                </ul>
                <div class="mt-4 p-4 bg-white rounded-lg">
                  <p class="text-sm text-gray-600">
                    <strong>Note:</strong> Insurance plans can change frequently. Please call us at 
                    <a href="tel:662-349-1999" class="text-teal font-semibold">(662) 349-1999</a> 
                    to verify your specific insurance plan is accepted before your appointment.
                  </p>
                </div>
              </div>

              <!-- Lab Services FAQ -->
              <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200">
                <h2 class="text-2xl font-bold text-navy mb-4">Do you offer lab services on-site?</h2>
                <p class="text-gray-700 mb-4">
                  Yes, we offer comprehensive lab services at our facility for your convenience. 
                  Common lab work includes:
                </p>
                <ul class="space-y-2 text-gray-700 mb-4">
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Blood glucose and hemoglobin A1C testing</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Cholesterol and lipid panels</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Complete blood count (CBC)</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Basic metabolic panels</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Thyroid function tests</span>
                  </li>
                </ul>
                <p class="text-gray-700">
                  Most results are available within 24-48 hours. You can access your results through our patient portal.
                </p>
              </div>

              <!-- Telehealth FAQ -->
              <div class="bg-light-blue p-8 rounded-lg">
                <h2 class="text-2xl font-bold text-navy mb-4">Do you offer telehealth appointments?</h2>
                <p class="text-gray-700 mb-4">
                  Yes, we offer telehealth appointments for certain types of visits, including:
                </p>
                <ul class="space-y-2 text-gray-700 mb-4">
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Follow-up appointments for chronic conditions</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Medication management consultations</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Review of lab results and test findings</span>
                  </li>
                  <li class="flex items-start space-x-2">
                    <span class="text-teal font-bold mt-1">✓</span>
                    <span>Minor illness consultations</span>
                  </li>
                </ul>
                <p class="text-gray-700">
                  To schedule a telehealth appointment, please call our office at 
                  <a href="tel:662-349-1999" class="text-navy font-semibold">(662) 349-1999</a>.
                </p>
              </div>

              <!-- Payment FAQ -->
              <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200">
                <h2 class="text-2xl font-bold text-navy mb-4">What payment methods do you accept?</h2>
                <p class="text-gray-700 mb-4">
                  We accept various payment methods to make healthcare more accessible:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <h3 class="text-lg font-semibold text-navy mb-3">Accepted Payments:</h3>
                    <ul class="space-y-2 text-gray-700">
                      <li class="flex items-center space-x-2">
                        <span class="text-teal font-bold">✓</span>
                        <span>Cash</span>
                      </li>
                      <li class="flex items-center space-x-2">
                        <span class="text-teal font-bold">✓</span>
                        <span>Check</span>
                      </li>
                      <li class="flex items-center space-x-2">
                        <span class="text-teal font-bold">✓</span>
                        <span>Credit/Debit Cards</span>
                      </li>
                      <li class="flex items-center space-x-2">
                        <span class="text-teal font-bold">✓</span>
                        <span>HSA/FSA Cards</span>
                      </li>
                    </ul>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-navy mb-3">Payment Plans:</h3>
                    <p class="text-gray-700">
                      We offer flexible payment plans for patients without insurance or with high deductibles. 
                      Please speak with our billing department to discuss options.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Appointment FAQ -->
              <div class="bg-light-blue p-8 rounded-lg">
                <h2 class="text-2xl font-bold text-navy mb-4">How do I schedule an appointment?</h2>
                <p class="text-gray-700 mb-4">
                  Scheduling an appointment is easy! You have several options:
                </p>
                <div class="space-y-4">
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-semibold text-navy">Call Our Office</h3>
                      <p class="text-gray-700">Phone: <a href="tel:662-349-1999" class="text-navy font-semibold">(662) 349-1999</a></p>
                      <p class="text-sm text-gray-600">Monday-Friday during business hours</p>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-semibold text-navy">Pre-Register Online</h3>
                      <p class="text-gray-700">Fill out your information ahead of time for faster service</p>
                      <a href="/#pre-register" class="text-teal font-semibold hover:underline">Pre-register here</a>
                    </div>
                  </div>
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-semibold text-navy">Same Day Appointments</h3>
                      <p class="text-gray-700">We reserve 15 same-day appointment slots daily</p>
                      <p class="text-sm text-gray-600">Call early for best availability</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Quick Info Sidebar -->
          <div class="lg:col-span-1">
            <div class="sticky top-8 space-y-6">
              <!-- Contact Card -->
              <div class="bg-navy text-white p-6 rounded-lg">
                <h3 class="text-xl font-bold mb-4">Still Have Questions?</h3>
                <p class="text-gray-300 mb-6">
                  Our friendly staff is here to help answer any questions you may have.
                </p>
                <div class="space-y-3 mb-6">
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <span>(662) 349-1999</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>7680 Airways Blvd.<br>Southaven, MS 38671</span>
                  </div>
                </div>
                <a href="tel:662-349-1999" class="w-full bg-teal text-white py-3 px-4 rounded-lg font-semibold text-center block hover:bg-teal-dark transition-colors">
                  Call Now
                </a>
              </div>
              
              <!-- Office Hours Card -->
              <div class="bg-light-blue p-6 rounded-lg">
                <h3 class="text-xl font-bold text-navy mb-4">Office Hours</h3>
                <div class="space-y-2 text-gray-700">
                  <div class="flex justify-between">
                    <span class="font-medium">Mon & Wed:</span>
                    <span>7:00 AM - 5:00 PM</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Tue & Thu:</span>
                    <span>8:00 AM - 5:00 PM</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Friday:</span>
                    <span>7:00 AM - 11:00 AM</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Weekend:</span>
                    <span>Closed</span>
                  </div>
                </div>
              </div>
              
              <!-- Patient Portal Card -->
              <div class="bg-white p-6 rounded-lg border border-gray-200">
                <h3 class="text-xl font-bold text-navy mb-4">Patient Portal</h3>
                <p class="text-gray-700 mb-4">
                  Access your health records, lab results, and request prescription refills online.
                </p>
                <a href="/patient-portal" class="w-full bg-navy text-white py-3 px-4 rounded-lg font-semibold text-center block hover:bg-blue-800 transition-colors">
                  Access Portal
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>