---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Hours & Location | Southaven Internal Medicine"
  description="Visit Southaven Internal Medicine at 7680 Airways Blvd, Southaven, MS. Office hours, directions, and contact information for our internal medicine practice."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="bg-navy py-16">
      <div class="container-custom">
        <div class="text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-4">Hours & Location</h1>
          <p class="text-xl text-gray-300 max-w-2xl mx-auto">
            Conveniently located in Southaven, MS with flexible hours to serve you better
          </p>
        </div>
      </div>
    </section>

    <!-- Hours Section -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Regular Hours -->
          <div class="bg-light-blue p-8 rounded-lg">
            <h2 class="text-3xl font-bold text-navy mb-6">Regular Clinic Hours</h2>
            <div class="space-y-4">
              <div class="flex justify-between items-center py-3 border-b border-gray-300">
                <span class="font-semibold text-navy">Monday & Wednesday</span>
                <span class="text-gray-700">7:00 AM - 5:00 PM</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-300">
                <span class="font-semibold text-navy">Tuesday & Thursday</span>
                <span class="text-gray-700">8:00 AM - 5:00 PM</span>
              </div>
              <div class="flex justify-between items-center py-3">
                <span class="font-semibold text-navy">Friday</span>
                <span class="text-gray-700">7:00 AM - 11:00 AM</span>
              </div>
            </div>
            
            <div class="mt-8 p-6 bg-teal bg-opacity-10 rounded-lg">
              <div class="flex items-center space-x-3 mb-3">
                <svg class="w-6 h-6 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h3 class="text-lg font-semibold text-navy">Same Day Appointments</h3>
              </div>
              <p class="text-gray-700">
                <strong>Please Note:</strong> We have 15 appointments open access for same day appointments every day.
              </p>
            </div>
          </div>
          
          <!-- Holiday Hours -->
          <div class="bg-navy p-8 rounded-lg text-white">
            <h2 class="text-3xl font-bold mb-6">Holiday Hours</h2>
            
            <div class="mb-6">
              <h3 class="text-xl font-semibold mb-4 text-teal">Closed On:</h3>
              <ul class="space-y-3">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>Memorial Day</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>July 4th</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>Labor Day</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>Thanksgiving Day</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>Christmas Day</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span>New Year's Day</span>
                </li>
              </ul>
            </div>
            
            <div class="p-4 bg-white bg-opacity-10 rounded-lg">
              <p class="text-teal font-semibold">We are open all other holidays</p>
            </div>
          </div>
        </div>
        
        <!-- Contact CTA -->
        <div class="text-center mt-12">
          <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
            Call (662) 349-1999 to Schedule
          </a>
        </div>
      </div>
    </section>

    <!-- Location Section -->
    <section class="section-padding bg-light-blue">
      <div class="container-custom">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-4">Location/Directions</h2>
          <p class="text-lg text-gray-700">Our office is located at 7680 Airways Blvd. Southaven, MS 38671</p>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Map -->
          <div>
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286992/auto-site-builder/railway-test-1/image_8.jpg" 
              alt="Map showing Southaven Internal Medicine location" 
              class="w-full rounded-lg shadow-lg"
            />
            
            <div class="mt-6 bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-xl font-semibold text-navy mb-4">Address Details</h3>
              <div class="space-y-2 text-gray-700">
                <p><strong>7680 Airways Blvd.</strong></p>
                <p>Southaven, MS 38671</p>
                <p class="text-sm text-gray-600 mt-3">
                  <strong>Important:</strong> Our office is below the children's clinic
                </p>
              </div>
              
              <div class="mt-6 flex space-x-4">
                <a 
                  href="https://maps.google.com/?q=7680+Airways+Blvd+Southaven+MS+38671" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-primary"
                >
                  Get Directions
                </a>
                <a href="tel:662-349-1999" class="btn-secondary">
                  Call Office
                </a>
              </div>
            </div>
          </div>
          
          <!-- Office Photos -->
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-xl font-semibold text-navy mb-4">Office Entrance</h3>
              <img 
                src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286992/auto-site-builder/railway-test-1/image_9.jpg" 
                alt="Office entrance - turn in here" 
                class="w-full rounded-lg mb-3"
              />
              <p class="text-gray-700 text-center font-medium">Turn in here</p>
              <p class="text-sm text-gray-600 text-center">Our office is below the children's clinic</p>
            </div>
            
            <div class="bg-navy p-6 rounded-lg text-white">
              <h3 class="text-xl font-semibold mb-4">Contact Information</h3>
              <div class="space-y-3">
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <span>Phone: (662) 349-1999</span>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v6l5 5 5-5V4M7 4l5-2 5 2M7 4l5 2m0 0l5-2m-5 2v6m0 0l-5 5m5-5l5 5"></path>
                  </svg>
                  <span>Fax: (662) 349-9734</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>