---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Patient Portal | Southaven Internal Medicine"
  description="Access your health records, test results, and request prescription refills through our secure patient portal. Convenient healthcare management at your fingertips."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://res.cloudinary.com/dil14r8je/image/upload/v1768286992/auto-site-builder/railway-test-1/image_6.jpg')"
      ></div>
      <div class="absolute inset-0 bg-navy bg-opacity-75"></div>
      
      <div class="relative z-10 container-custom">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h1 class="text-4xl lg:text-5xl font-bold mb-6">
            Welcome to the Patient Portal
          </h1>
          <p class="text-xl mb-8">
            Secure, convenient access to your health information
          </p>
          <a href="#portal-access" class="btn-primary text-lg px-8 py-4">
            Access Portal Now
          </a>
        </div>
      </div>
    </section>

    <!-- Portal Information -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-navy mb-6">What is the patient portal?</h2>
            <p class="text-lg text-gray-700 mb-6 leading-relaxed">
              This forum allows you to connect with your physician in a convenient and secure environment. 
              Upon enrolling in the portal, patients can access test results, request refills, and view health records online.
            </p>
            
            <div class="bg-light-blue p-6 rounded-lg mb-6">
              <h3 class="text-xl font-semibold text-navy mb-4">Portal Features:</h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Access test results online</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Request prescription refills</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>View health records</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Secure messaging with providers</span>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="text-center">
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286992/auto-site-builder/railway-test-1/image_7.jpg" 
              alt="Patient portal login screen" 
              class="mx-auto rounded-lg shadow-lg mb-6 max-w-md"
            />
            <div id="portal-access" class="bg-navy p-6 rounded-lg text-white">
              <h3 class="text-xl font-semibold mb-4">Ready to Access Your Portal?</h3>
              <p class="text-gray-300 mb-6">Secure login to manage your healthcare online</p>
              <a href="#" class="btn-primary w-full block text-center">
                Click Here to Access the Portal
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Registration Process -->
    <section class="section-padding bg-light-blue">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-navy mb-8 text-center">
            How do I register for the portal?
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
            <div class="bg-white p-8 rounded-lg shadow-md">
              <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-2xl font-bold text-white">1</span>
              </div>
              <h3 class="text-xl font-semibold text-navy mb-4 text-center">Request Invitation</h3>
              <p class="text-gray-700 text-center">
                Give us a call and ask for us to send you an invite to your email, or you will be sent one 
                automatically at your next office visit.
              </p>
            </div>
            
            <div class="bg-white p-8 rounded-lg shadow-md">
              <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-2xl font-bold text-white">2</span>
              </div>
              <h3 class="text-xl font-semibold text-navy mb-4 text-center">Follow Email Instructions</h3>
              <p class="text-gray-700 text-center">
                Your invite will come to your email and have instructions to set up your account with 
                your personal information.
              </p>
            </div>
          </div>
          
          <div class="text-center">
            <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
              Call (662) 349-1999 to Get Started
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Healow App Section -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-navy mb-6">What is Healow?</h2>
          <p class="text-lg text-gray-700 mb-8 leading-relaxed">
            Healow is our mobile app that offers you all kinds of features through your portal account. 
            Download the app and use our unique practice code to register your account.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <div class="bg-light-blue p-6 rounded-lg">
              <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-navy mb-2">View Records</h3>
              <p class="text-sm text-gray-600">Access your health records on the go</p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg">
              <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-navy mb-2">Request Refills</h3>
              <p class="text-sm text-gray-600">Easily request prescription refills</p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg">
              <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-navy mb-2">Check In</h3>
              <p class="text-sm text-gray-600">Check in for appointments remotely</p>
            </div>
            
            <div class="bg-light-blue p-6 rounded-lg">
              <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-navy mb-2">Contact Us</h3>
              <p class="text-sm text-gray-600">Secure messaging with our team</p>
            </div>
          </div>
          
          <div class="bg-navy p-8 rounded-lg text-white">
            <p class="mb-4">
              <strong>Important:</strong> Your Healow login info is the same as your portal login info.
            </p>
            <p class="text-gray-300">
              Questions? Give us a call at <a href="tel:662-349-1999" class="text-teal font-semibold">(662) 349-1999</a> 
              or ask the medical assistant on your next visit!
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>