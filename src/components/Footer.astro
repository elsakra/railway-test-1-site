---
// Footer component
---

<footer class="bg-navy text-white">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Practice Info -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-6">
          <img 
            src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286991/auto-site-builder/railway-test-1/image_0.jpg" 
            alt="Southaven Internal Medicine Logo" 
            class="h-12 w-12 rounded-full object-cover"
          />
          <div>
            <h3 class="text-xl font-bold text-white">Southaven Internal Medicine</h3>
            <p class="text-gray-300">est. 1996</p>
          </div>
        </div>
        <p class="text-gray-300 mb-6 max-w-md">
          Dedicated to providing our patients with the highest level of care in a friendly and comfortable environment. 
          Our goal is to make our patients feel like they are family.
        </p>
        <div class="flex items-center space-x-4">
          <a 
            href="https://www.facebook.com" 
            class="bg-white bg-opacity-20 p-3 rounded-full hover:bg-opacity-30 transition-all"
            aria-label="Follow us on Facebook"
          >
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286991/auto-site-builder/railway-test-1/image_3.png" 
              alt="Facebook" 
              class="h-6 w-6"
            />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold mb-6 text-white">Quick Links</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-gray-300 hover:text-teal transition-colors">Home</a></li>
          <li><a href="/patient-portal" class="text-gray-300 hover:text-teal transition-colors">Patient Portal</a></li>
          <li><a href="/hours-location" class="text-gray-300 hover:text-teal transition-colors">Hours & Location</a></li>
          <li><a href="/providers" class="text-gray-300 hover:text-teal transition-colors">Meet our Providers</a></li>
          <li><a href="/faq" class="text-gray-300 hover:text-teal transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-semibold mb-6 text-white">Contact Info</h4>
        <div class="space-y-4">
          <div class="flex items-start space-x-3">
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768286991/auto-site-builder/railway-test-1/image_4.png" 
              alt="Location" 
              class="h-5 w-4 mt-1 filter brightness-0 invert"
            />
            <div class="text-gray-300">
              <p>7680 Airways Blvd.</p>
              <p>Southaven, MS 38671</p>
            </div>
          </div>
          <div class="text-gray-300">
            <p class="font-semibold">Phone: (662) 349-1999</p>
            <p>Fax: (662) 349-9734</p>
          </div>
          <div class="pt-4">
            <a href="tel:662-349-1999" class="btn-primary">
              Call Now
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Office Hours Summary -->
    <div class="border-t border-gray-600 mt-12 pt-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <h4 class="text-lg font-semibold mb-4 text-white">Office Hours</h4>
          <div class="text-gray-300 space-y-1">
            <p><span class="font-medium">Mon & Wed:</span> 7:00 AM - 5:00 PM</p>
            <p><span class="font-medium">Tue & Thu:</span> 8:00 AM - 5:00 PM</p>
            <p><span class="font-medium">Friday:</span> 7:00 AM - 11:00 AM</p>
          </div>
        </div>
        <div class="text-center md:text-right">
          <p class="text-gray-300 mb-4">Same day appointments available</p>
          <p class="text-lg font-semibold text-teal">15 open access appointments daily</p>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-600 mt-8 pt-8 text-center">
      <p class="text-gray-400">
        © 2024 Southaven Internal Medicine. All rights reserved. | 
        <span class="text-teal">Dedicated to our patients since 1996</span>
      </p>
    </div>
  </div>
</footer>