---
// Contact component
---

<section id="pre-register" class="section-padding bg-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-6">
          Get in Touch
        </h2>
        <p class="text-lg text-gray-700 mb-8">
          Ready to experience compassionate, comprehensive internal medicine care? 
          Contact us today to schedule your appointment or pre-register for faster service.
        </p>
        
        <!-- Contact Details -->
        <div class="space-y-6 mb-8">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-1">Phone</h3>
              <p class="text-gray-700">Primary: (662) 349-1999</p>
              <p class="text-gray-700">Fax: (662) 349-9734</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-1">Address</h3>
              <p class="text-gray-700">7680 Airways Blvd.</p>
              <p class="text-gray-700">Southaven, MS 38671</p>
              <p class="text-sm text-gray-600 mt-1">Our office is below the children's clinic</p>
            </div>
          </div>
          
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-1">Hours</h3>
              <div class="text-gray-700 space-y-1">
                <p>Mon & Wed: 7:00 AM - 5:00 PM</p>
                <p>Tue & Thu: 8:00 AM - 5:00 PM</p>
                <p>Fri: 7:00 AM - 11:00 AM</p>
                <p class="text-sm text-teal font-medium mt-2">15 Same Day Appointments Daily</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:662-349-1999" class="btn-primary text-center">
            Call (662) 349-1999
          </a>
          <a href="/patient-portal" class="btn-secondary text-center">
            Pre-Register Online
          </a>
        </div>
      </div>
      
      <!-- Map / Additional Info -->
      <div>
        <div class="bg-light-blue p-8 rounded-lg h-full">
          <h3 class="text-2xl font-bold text-navy mb-6">Why Choose Southaven Internal Medicine?</h3>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-navy mb-1">30+ Years of Experience</h4>
                <p class="text-gray-700 text-sm">Serving Southaven since 1996 with dedicated, compassionate care.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-navy mb-1">Board Certified Physicians</h4>
                <p class="text-gray-700 text-sm">Dr. Magdi Wassef and Dr. Mary Missak provide expert internal medicine care.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-navy mb-1">Family-Centered Approach</h4>
                <p class="text-gray-700 text-sm">We treat our patients like family in a comfortable environment.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-navy mb-1">Preventative Focus</h4>
                <p class="text-gray-700 text-sm">Emphasis on health screenings and preventative medicine.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="w-8 h-8 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-navy mb-1">Same Day Availability</h4>
                <p class="text-gray-700 text-sm">15 same-day appointments available daily for urgent needs.</p>
              </div>
            </div>
          </div>
          
          <div class="mt-8 p-6 bg-white rounded-lg">
            <h4 class="font-semibold text-navy mb-3">Insurance Accepted</h4>
            <p class="text-gray-700 text-sm mb-2">We accept all major insurances. Please call to verify your specific plan.</p>
            <a href="/faq" class="text-teal hover:text-teal-dark font-medium text-sm">View Insurance Details →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>