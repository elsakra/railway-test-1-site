---
// About component
---

<section class="section-padding bg-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <div class="max-w-xl">
          <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-6">
            Your Health is Our Priority
          </h2>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            Our goal is to make our patients feel like they are family. As a practice, we focus on 
            <strong class="text-navy">preventative medicine</strong>, 
            <strong class="text-navy">health screenings</strong>, and helping our community find 
            solutions to the health challenges they face.
          </p>
          <p class="text-lg text-gray-700 mb-8 leading-relaxed">
            Our <strong class="text-navy">board certified physicians</strong> will work with you to achieve 
            the best possible state of health and well being.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:662-349-1999" class="btn-primary">
              Call (662) 349-1999
            </a>
            <a href="#pre-register" class="btn-secondary">
              Click Here to Pre Register
            </a>
          </div>
        </div>
      </div>
      
      <!-- Features Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-light-blue p-6 rounded-lg card-hover">
          <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-2">Preventative Medicine</h3>
          <p class="text-gray-700">Comprehensive health screenings and preventative care to keep you healthy.</p>
        </div>
        
        <div class="bg-light-blue p-6 rounded-lg card-hover">
          <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-2">Family-Centered Care</h3>
          <p class="text-gray-700">We treat our patients like family in a comfortable, welcoming environment.</p>
        </div>
        
        <div class="bg-light-blue p-6 rounded-lg card-hover">
          <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-2">Same Day Appointments</h3>
          <p class="text-gray-700">15 same-day appointments available daily for urgent care needs.</p>
        </div>
        
        <div class="bg-light-blue p-6 rounded-lg card-hover">
          <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-2">Board Certified</h3>
          <p class="text-gray-700">Board certified physicians with over 30 years of combined experience.</p>
        </div>
      </div>
    </div>
  </div>
</section>