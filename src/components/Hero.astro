---
// Hero component
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div 
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://res.cloudinary.com/dil14r8je/image/upload/v1768286991/auto-site-builder/railway-test-1/image_1.jpg')"
  ></div>
  
  <!-- Enhanced Overlay for better text contrast -->
  <div class="absolute inset-0 hero-overlay"></div>
  
  <!-- Content with improved text styling -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-white mb-6 leading-tight text-shadow-dark">
      Dedicated to our patients
      <span class="block text-white drop-shadow-lg">since 1996</span>
    </h1>
    
    <p class="text-xl sm:text-2xl text-white mb-8 max-w-3xl mx-auto leading-relaxed text-shadow font-medium">
      Southaven Internal Medicine has been committed to providing our patients with the highest level of care 
      in a friendly and comfortable environment.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
        Call (662) 349-1999
      </a>
      <a href="#pre-register" class="bg-white text-navy px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 hover:bg-gray-100 hover:transform hover:scale-105 shadow-xl">
        Pre-Register Now
      </a>
    </div>
    
    <!-- Trust Indicators with improved visibility -->
    <div class="mt-12 flex flex-wrap justify-center items-center gap-8 text-white">
      <div class="text-center bg-black bg-opacity-30 px-4 py-3 rounded-lg backdrop-blur-sm">
        <div class="text-2xl font-bold text-white text-shadow">30+</div>
        <div class="text-sm text-shadow">Years Experience</div>
      </div>
      <div class="text-center bg-black bg-opacity-30 px-4 py-3 rounded-lg backdrop-blur-sm">
        <div class="text-2xl font-bold text-white text-shadow">2</div>
        <div class="text-sm text-shadow">Board Certified Physicians</div>
      </div>
      <div class="text-center bg-black bg-opacity-30 px-4 py-3 rounded-lg backdrop-blur-sm">
        <div class="text-2xl font-bold text-white text-shadow">15</div>
        <div class="text-sm text-shadow">Same Day Appointments</div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>