---
// Services component
---

<section class="section-padding bg-light-blue">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-4">
        Comprehensive Internal Medicine Services
      </h2>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">
        Our experienced physicians provide a full range of internal medicine services 
        to help you maintain optimal health and wellness.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Service 1 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Preventative Care</h3>
        <p class="text-gray-700 mb-4">Comprehensive health screenings, annual physicals, and preventative medicine to keep you healthy.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Annual Physical Exams</li>
          <li>• Health Risk Assessments</li>
          <li>• Vaccination Services</li>
          <li>• Cancer Screenings</li>
        </ul>
      </div>
      
      <!-- Service 2 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Chronic Disease Management</h3>
        <p class="text-gray-700 mb-4">Expert management of chronic conditions to improve your quality of life and health outcomes.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Diabetes Management</li>
          <li>• Hypertension Care</li>
          <li>• Heart Disease Treatment</li>
          <li>• Cholesterol Management</li>
        </ul>
      </div>
      
      <!-- Service 3 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Laboratory Services</h3>
        <p class="text-gray-700 mb-4">Complete diagnostic testing and lab work with quick results for accurate diagnosis and treatment.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Blood Tests</li>
          <li>• Urine Analysis</li>
          <li>• Cholesterol Screening</li>
          <li>• Diabetes Testing</li>
        </ul>
      </div>
      
      <!-- Service 4 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Same Day Appointments</h3>
        <p class="text-gray-700 mb-4">Urgent care appointments available with 15 same-day slots reserved daily for immediate needs.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Urgent Medical Issues</li>
          <li>• Acute Illness Treatment</li>
          <li>• Follow-up Care</li>
          <li>• Medication Management</li>
        </ul>
      </div>
      
      <!-- Service 5 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Patient Portal Access</h3>
        <p class="text-gray-700 mb-4">Convenient online access to your health records, test results, and prescription refill requests.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• View Test Results</li>
          <li>• Request Refills</li>
          <li>• Access Health Records</li>
          <li>• Secure Messaging</li>
        </ul>
      </div>
      
      <!-- Service 6 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Comprehensive Care</h3>
        <p class="text-gray-700 mb-4">Complete internal medicine services covering all aspects of adult healthcare and wellness.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Adult Medicine</li>
          <li>• Wellness Exams</li>
          <li>• Health Consultations</li>
          <li>• Treatment Planning</li>
        </ul>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="text-center mt-12">
      <p class="text-lg text-gray-700 mb-6">Ready to experience quality healthcare?</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
          Call (662) 349-1999
        </a>
        <a href="#pre-register" class="btn-secondary text-lg px-8 py-4">
          Pre-Register Today
        </a>
      </div>
    </div>
  </div>
</section>