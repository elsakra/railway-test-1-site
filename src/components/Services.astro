---
// Services component
---

<section class="section-padding bg-light-blue">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-4">
        Comprehensive Internal Medicine Services
      </h2>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">
        Our experienced physicians provide a full range of internal medicine services 
        to help you maintain optimal health and wellness.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Service 1 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Preventative Care</h3>
        <p class="text-gray-700 mb-4">Comprehensive health screenings, annual physicals, and preventative medicine to keep you healthy.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Annual Physical Exams</li>
          <li>• Health Risk Assessments</li>
          <li>• Vaccination Services</li>
          <li>• Cancer Screenings</li>
        </ul>
      </div>
      
      <!-- Service 2 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Chronic Disease Management</h3>
        <p class="text-gray-700 mb-4">Expert management of chronic conditions to improve your quality of life and health outcomes.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Diabetes Management</li>
          <li>• Hypertension Care</li>
          <li>• Heart Disease Treatment</li>
          <li>• Cholesterol Management</li>
        </ul>
      </div>
      
      <!-- Service 3 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-4.90.602L2.24 14.07a.5.5 0 01-.093-.805l4.95-4.95a2 2 0 011.414-.586h9.072a2 2 0 012 2v5.072a2 2 0 01-.586 1.414l-2.621 2.621z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Diagnostic Services</h3>
        <p class="text-gray-700 mb-4">Advanced diagnostic testing and laboratory services for accurate diagnosis and treatment.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Laboratory Testing</li>
          <li>• EKG Services</li>
          <li>• Blood Work Analysis</li>
          <li>• Health Assessments</li>
        </ul>
      </div>
      
      <!-- Service 4 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Same Day Care</h3>
        <p class="text-gray-700 mb-4">Urgent care and same-day appointments for immediate health concerns and acute illness.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Same Day Appointments</li>
          <li>• Urgent Care Services</li>
          <li>• Acute Illness Treatment</li>
          <li>• Emergency Consultations</li>
        </ul>
      </div>
      
      <!-- Service 5 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Women's Health</h3>
        <p class="text-gray-700 mb-4">Specialized care addressing the unique health needs of women throughout all life stages.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Annual Wellness Exams</li>
          <li>• Hormone Management</li>
          <li>• Menopause Care</li>
          <li>• Preventative Screenings</li>
        </ul>
      </div>
      
      <!-- Service 6 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Senior Care</h3>
        <p class="text-gray-700 mb-4">Comprehensive healthcare services designed specifically for older adults and their unique needs.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Geriatric Medicine</li>
          <li>• Medication Management</li>
          <li>• Fall Prevention</li>
          <li>• Chronic Disease Care</li>
        </ul>
      </div>
    </div>
  </div>
</section>