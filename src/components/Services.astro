---
// Services component
---

<section class="section-padding bg-light-blue">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-navy mb-4">
        Comprehensive Internal Medicine Services
      </h2>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">
        Our experienced physicians provide a full range of internal medicine services 
        to help you maintain optimal health and wellness.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Service 1 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Preventative Care</h3>
        <p class="text-gray-700 mb-4">Comprehensive health screenings, annual physicals, and preventative medicine to keep you healthy.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Annual Physical Exams</li>
          <li>• Health Risk Assessments</li>
          <li>• Vaccination Services</li>
          <li>• Cancer Screenings</li>
        </ul>
      </div>
      
      <!-- Service 2 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Chronic Disease Management</h3>
        <p class="text-gray-700 mb-4">Expert management of chronic conditions to improve your quality of life and health outcomes.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Diabetes Management</li>
          <li>• Hypertension Care</li>
          <li>• Heart Disease Treatment</li>
          <li>• Cholesterol Management</li>
        </ul>
      </div>
      
      <!-- Service 3 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Diagnostic Services</h3>
        <p class="text-gray-700 mb-4">On-site laboratory services and diagnostic testing for accurate and timely results.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Laboratory Testing (AEL)</li>
          <li>• Blood Work Analysis</li>
          <li>• Diagnostic Evaluations</li>
          <li>• Health Monitoring</li>
        </ul>
      </div>
      
      <!-- Service 4 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Telehealth Services</h3>
        <p class="text-gray-700 mb-4">Convenient virtual consultations when you can't make it to the office.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Secure Video Calls</li>
          <li>• Remote Consultations</li>
          <li>• Follow-up Appointments</li>
          <li>• Prescription Management</li>
        </ul>
      </div>
      
      <!-- Service 5 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Same Day Care</h3>
        <p class="text-gray-700 mb-4">Urgent care and same-day appointments for immediate health concerns.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• 15 Daily Open Access Slots</li>
          <li>• Urgent Care Services</li>
          <li>• Acute Illness Treatment</li>
          <li>• Same Day Scheduling</li>
        </ul>
      </div>
      
      <!-- Service 6 -->
      <div class="bg-white p-8 rounded-lg shadow-md card-hover text-center">
        <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-navy mb-4">Patient Portal</h3>
        <p class="text-gray-700 mb-4">Easy online access to your health records, test results, and prescription refills.</p>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Online Health Records</li>
          <li>• Test Results Access</li>
          <li>• Prescription Refills</li>
          <li>• Secure Messaging</li>
        </ul>
      </div>
    </div>
    
    <div class="text-center mt-12">
      <a href="tel:662-349-1999" class="btn-primary text-lg px-8 py-4">
        Schedule Your Appointment
      </a>
    </div>
  </div>
</section>